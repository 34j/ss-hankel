@article{sakurai_projection_2003,
	title = {A projection method for generalized eigenvalue problems using numerical integration},
	volume = {159},
	issn = {0377-0427},
	url = {https://www.sciencedirect.com/science/article/pii/S037704270300565X},
	doi = {10.1016/S0377-0427(03)00565-X},
	series = {6th Japan-China Joint Seminar on Numerical Mathematics; In Search for the Frontier of Computational and Applied Mathematics toward the 21st Century},
	abstract = {In this paper, we propose a method for finding certain eigenvalues of a generalized eigenvalue problem that lie in a given domain of the complex plane. The proposed method projects the matrix pencil onto a subspace associated with the eigenvalues that are located in the domain via numerical integration.},
